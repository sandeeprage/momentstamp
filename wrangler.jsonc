{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "momentstamp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOOTH_ROOMS", "class_name": "BoothRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoothRoom"] }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
